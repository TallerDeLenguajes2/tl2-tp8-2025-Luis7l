@using Models;
@model Producto;

@{
    ViewData["title"] = "Eliminar ProWducto";
}

<h1 class="text-center text-danger">Eliminacion de producto...</h1>


<section>
    <form asp-action="delete">
        <section asp-validation-summary="ModelOnly" class="text-danger"></section>
        <input type="hidden" asp-for="IdProducto">
        <section class="mb-3">
            <label asp-for="Descripcion" class="form-label"></label>
            <input asp-for="Descripcion" class="form-control">
        </section>
        <section class="mb-3">
            <label asp-for="Precio" class="form-label"></label>
            <input asp-for="Precio" class="form-control">
        </section>
        <section class="form-group">
            <input type="submit" value="Eliminar" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </section>

    </form>

</section>